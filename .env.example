# Copy to .env for local Docker Compose. Generate a unique URL-safe
# POSTGRES_PASSWORD and AUTH_SECRET_KEY before starting the stack.
POSTGRES_DB=aerosense
POSTGRES_USER=aerosense
POSTGRES_PASSWORD=
CORS_ORIGINS=http://localhost:3000
AUTH_SECRET_KEY=
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
OPENAQ_API_KEY=
NASA_FIRMS_MAP_KEY=
cams=
GEMINI_API_KEY=
GEMINI_PROVIDER=api_key
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS_FILE=
REDIS_URL=redis://redis:6379/0
KAFKA_BOOTSTRAP_SERVERS=
ALLOW_DOCUMENT_UPLOADS=false
AQI_ALERT_THRESHOLD=100
OBSERVATION_RETENTION_DAYS=365
RAW_PAYLOAD_RETENTION_DAYS=30
EVENT_RETENTION_DAYS=180
