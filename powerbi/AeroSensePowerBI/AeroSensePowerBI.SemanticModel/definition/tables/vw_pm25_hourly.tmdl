table vw_pm25_hourly
	lineageTag: d95f2ce1-ca4d-5c97-9cc0-5ae04c6ec11a

	measure 'Mean PM2.5 (µg/m³)' = AVERAGE('vw_pm25_hourly'[pm25_mean_ug_m3])
		formatString: 0.0
		lineageTag: 441aaf2e-5df6-5ad8-9d09-190ec9280b19

	measure 'Observed City-Hours' = COUNTROWS('vw_pm25_hourly')
