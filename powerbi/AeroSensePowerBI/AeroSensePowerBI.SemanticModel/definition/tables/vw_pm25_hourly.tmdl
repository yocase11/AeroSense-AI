	partition vw_pm25_hourly = m
		mode: import
		source =
			let
				Source = PostgreSQL.Database("localhost:5432", "aerosense", [Query = "SELECT * FROM public.vw_pm25_hourly"]),
				Typed = Table.TransformColumnTypes(Source, {{
					{"hour_utc", type datetime}, {"hour_ist", type datetime},
					{"local_hour", Int64.Type}, {"local_weekday_num", Int64.Type},
					{"pm25_mean_ug_m3", type number}, {"pm25_measurement_count", Int64.Type},
					{"pm25_station_count", Int64.Type}, {"temperature_c", type number},
					{"wind_speed_kmh", type number}, {"humidity_pct", type number},
					{"precipitation_mm", type number}
				}})
			in
				Typed
